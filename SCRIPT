    (outdir / "subs").mkdir(exist_ok=True)
    (outdir / "vt").mkdir(exist_ok=True)
    (outdir / "bypassed").mkdir(exist_ok=True)
    (outdir / "logs").mkdir(exist_ok=True)

    log_file = outdir / "logs" / f"{domain}_recon.log"

    # Full recon enables everything
    if args.full_recon:
        args.vt = True
        args.bypass = True
        args.url_secrets = True
        args.subs_deep = True
        args.unified_report = True

    # Determine what to run
    run_subs = not args.vt_only
    run_vt = args.vt or args.vt_only
    run_secrets = args.url_secrets or args.vt_only or args.full_recon
    run_bypass = args.bypass and not args.vt_only
    run_status = not args.vt_only  # Always run status codes when doing subs

    # =====================================================================
    # PHASE 1: SUBDOMAIN ENUMERATION
    # =====================================================================
    subs = []
    all_subs = []
    if run_subs:
        log_message(f"\n{'='*60}", log_file)
        log_message(f"PHASE 1: Subdomain Enumeration", log_file)
        log_message(f"{'='*60}\n", log_file)

        subs, all_subs = enum_subdomains(
            domain, outdir,
            deep=args.subs_deep,
            recursive=args.subs_recursive,
            limit=args.subs_limit,
            threads=args.subs_threads,
            log_file=log_file
        )

        if args.subs_only:
            log_message(f"\n{'='*60}", log_file)
            log_message(f"SUBDOMAIN ENUMERATION COMPLETE", log_file)
            log_message(f"{'='*60}", log_file)
            log_message(f"Results in: {outdir / 'subs'}", log_file)
            return

    # =====================================================================
    # PHASE 2: STATUS CODES (httpx) — ONE FILE + SUBDOMAIN INFO DICT
    # =====================================================================
    status_codes = {}
    bypass_403_urls = []
    subdomain_info = {}  # NEW: dict for unified report
    if run_status and subs:
        log_message(f"\n{'='*60}", log_file)
        log_message(f"PHASE 2: Status Code Scan (httpx)", log_file)
        log_message(f"{'='*60}\n", log_file)

        # Build full URLs from live subs for status scan
        urls_to_scan = []
        for sub in subs:
            urls_to_scan.append(f"https://{sub}")
            urls_to_scan.append(f"http://{sub}")
        urls_to_scan = list(dict.fromkeys(urls_to_scan))

        status_codes, bypass_403_urls, subdomain_info = scan_status_codes_with_httpx(
            urls_to_scan, outdir, domain, threads=args.threads, log_file=log_file
        )

    # =====================================================================
    # PHASE 3: VIRUSTOTAL — BUILT-IN PYTHON SCANNER
    # =====================================================================
    vt_results = {}  # NEW: structured VT results per subdomain
    vt_urls = []
    if run_vt and all_subs:
        log_message(f"\n{'='*60}", log_file)
        log_message(f"PHASE 3: VirusTotal API Scan (Built-in)", log_file)
        log_message(f"{'='*60}\n", log_file)

        vt_results, vt_urls = vt_api_scan(
            all_subs, domain, outdir,
            delay=args.vt_delay,
            vt_limit=args.vt_limit,
            log_file=log_file
        )

    # =====================================================================
    # PHASE 4: UNIFIED REPORT (NEW)
    # =====================================================================
    if args.unified_report and (subdomain_info or vt_results):
        log_message(f"\n{'='*60}", log_file)
        log_message(f"PHASE 4: Unified Report", log_file)
        log_message(f"{'='*60}\n", log_file)

        generate_unified_report(
            domain, outdir, subdomain_info, vt_results,
            log_file=log_file
        )

    # =====================================================================
    # PHASE 5: URL SECRETS — VT URLs ONLY
    # =====================================================================
    url_secrets = []
    if run_secrets and vt_urls:
        log_message(f"\n{'='*60}", log_file)
        log_message(f"PHASE 5: URL Secrets Scan (VT URLs only)", log_file)
        log_message(f"{'='*60}\n", log_file)

        report_file = outdir / "reports" / f"{domain}_url_secrets.txt"
        url_secrets = scan_url_secrets(vt_urls, report_file, min_score=args.min_score, log_file=log_file)

    # =====================================================================
    # PHASE 6: 403 BYPASS
    # =====================================================================
    bypassed_403 = []
    if run_bypass:
        log_message(f"\n{'='*60}", log_file)
        log_message(f"PHASE 6: 403 Bypass", log_file)
        log_message(f"{'='*60}\n", log_file)

        if bypass_403_urls:
            bypassed_403 = bypass_403(bypass_403_urls, outdir, domain, threads=args.threads, log_file=log_file)
        elif subs:
            # Fallback: build URLs from subs if no 403 targets captured
            fallback_urls = [f"https://{sub}" for sub in subs] + [f"http://{sub}" for sub in subs]
            bypassed_403 = bypass_403(fallback_urls, outdir, domain, threads=args.threads, log_file=log_file)

    # =====================================================================
    # PHASE 7: MASTER REPORT
    # =====================================================================
    if not args.subs_only:
        log_message(f"\n{'='*60}", log_file)
        log_message(f"PHASE 7: Master Ranking Report", log_file)
        log_message(f"{'='*60}\n", log_file)

        all_findings = generate_master_report(
            domain, outdir, url_secrets, bypassed_403, status_codes,
            log_file=log_file
        )

        # Generate bug bounty ready report
        generate_bug_bounty_report(domain, outdir, all_findings, log_file=log_file)

    # =====================================================================
    # DONE
    # =====================================================================
    log_message(f"\n{'='*60}", log_file)
    log_message(f"ALL DONE! Results in: {outdir.absolute()}", log_file)
    log_message(f"{'='*60}\n", log_file)
    log_message("Key files:", log_file)
    log_message(f"  Subdomains:    {outdir / 'subs' / f'{domain}_subs_all.txt'}", log_file)
    log_message(f"  Live Subs:     {outdir / 'subs' / f'{domain}_subs_live.txt'}", log_file)
    log_message(f"  Status Codes:  {outdir / 'reports' / f'{domain}_status_codes.txt'}", log_file)
    log_message(f"  UNIFIED:       {outdir / 'reports' / f'{domain}_unified_report.txt'}", log_file)
    log_message(f"  VT Input:      {outdir / 'vt' / 'virus.txt'}", log_file)
    log_message(f"  VT Output:     {outdir / 'vt' / 'vt.txt'}", log_file)
    log_message(f"  VT Cache:      {outdir / 'vt' / 'vt_cache.json'}", log_file)
    log_message(f"  URL Secrets:   {outdir / 'reports' / f'{domain}_url_secrets.txt'}", log_file)
    log_message(f"  403 Bypass:    {outdir / 'reports' / f'{domain}_403_bypass.txt'}", log_file)
    log_message(f"  MASTER RANKED: {outdir / 'reports' / f'{domain}_master_ranked.txt'}", log_file)
    log_message(f"  BUG BOUNTY:    {outdir / 'reports' / f'{domain}_bug_bounty_ready.txt'}", log_file)
    log_message("")

if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n[!] Interrupted by user. Exiting...")
        sys.exit(0)
