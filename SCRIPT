# =============================================================================
# URL SECRETS SCANNER — VT URLs ONLY, INFO DISCLOSURE FOCUS
# =============================================================================

def scan_url_secrets(urls, report_file, min_score=50, log_file=None):
    """Scan URLs for embedded secrets — VT URLs only, info disclosure focus."""
    findings = []
    skipped_safe = 0
    skipped_ext = 0

    log_message(f"[*] Scanning {len(urls)} VT URLs for secrets (info disclosure focus)...", log_file)

    for url in urls:
        if should_skip_url_for_secrets(url):
            skipped_ext += 1
            continue

        parsed = urllib.parse.urlparse(url)
        query = parsed.query
        full_url = url

        for name, (pattern, score) in URL_SECRET_PATTERNS.items():
            if score < min_score:
                continue

            # Check query string
            for match in re.finditer(pattern, query):
                match_str = match.group(0)
                if is_safe_param(match_str):
                    skipped_safe += 1
                    continue
                findings.append({
                    'url': url,
                    'type': name,
                    'match': match_str,
                    'score': score,
                    'location': 'query',
                })

            # Check full URL (some patterns match path too)
            for match in re.finditer(pattern, full_url):
                match_str = match.group(0)
                if is_safe_param(match_str):
                    skipped_safe += 1
                    continue
                # Avoid duplicates
                if not any(f['url'] == url and f['match'] == match_str for f in findings):
                    findings.append({
                        'url': url,
                        'type': name,
                        'match': match_str,
                        'score': score,
                        'location': 'url',
                    })

    # Sort by score descending
    findings.sort(key=lambda x: -x['score'])

    with open(report_file, 'w') as f:
        f.write("=" * 80 + "\n")
        f.write("HANFY RECON v7.0 — URL SECRETS REPORT (INFO DISCLOSURE FOCUS)\n")
        f.write("=" * 80 + "\n\n")
        f.write(f"Total URLs scanned: {len(urls)}\n")
        f.write(f"Secrets found: {len(findings)}\n")
        f.write(f"Skipped (safe params): {skipped_safe}\n")
        f.write(f"Skipped (bad extensions): {skipped_ext}\n")
        f.write(f"Minimum score threshold: {min_score}\n\n")

        if findings:
            current_score = None
            for i, finding in enumerate(findings, 1):
                if finding['score'] != current_score:
                    current_score = finding['score']
                    label = severity_label(current_score)
                    f.write(f"\n{'='*80}\n")
                    f.write(f"{label} (Score: {current_score})\n")
                    f.write(f"{'='*80}\n\n")

                f.write(f"SECRET #{i}: {finding['type']}\n")
                f.write(f"URL: {finding['url']}\n")
                f.write(f"MATCH: {finding['match']}\n")
                f.write(f"LOCATION: {finding['location']}\n\n")
        else:
            f.write("No URL secrets found above threshold.\n")

    log_message(f"[+] URL secrets: {report_file} ({len(findings)} findings, {skipped_safe} safe-param skips, {skipped_ext} ext skips)", log_file)
    return findings


