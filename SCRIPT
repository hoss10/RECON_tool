# =============================================================================
# VIRUSTOTAL API — BUILT-IN PYTHON SCANNER (replaces vt-end)
# =============================================================================

def vt_api_scan(subdomains, domain, outdir, delay=15, vt_limit=0, log_file=None):
    """
    Built-in VirusTotal API scanner using Python requests.
    Multi-key rotation for faster scanning.
    Returns: (vt_results_dict, vt_urls_list)

    vt_results = {
        "sub.domain.com": {
            "malicious": 0, "suspicious": 1, "undetected": 79,
            "harmless": 0, "reputation": 0, "categories": []
        }
    }
    """
    if not REQUESTS_AVAILABLE:
        log_message("[-] 'requests' library not installed. Install: pip install requests", log_file)
        return {}, []

    vt_dir = Path(outdir) / "vt"
    vt_dir.mkdir(parents=True, exist_ok=True)

    virus_file = vt_dir / "virus.txt"
    vt_output_file = vt_dir / "vt.txt"
    vt_cache_file = vt_dir / "vt_cache.json"

    # Save virus.txt (clean subdomains for reference)
    with open(virus_file, 'w') as f:
        for sub in sorted(subdomains):
            f.write(f"{sub}\n")

    # Load cache if exists
    cached_results = {}
    if vt_cache_file.exists():
        try:
            with open(vt_cache_file) as f:
                cached_results = json.load(f)
            log_message(f"[*] Loaded VT cache: {len(cached_results)} cached entries", log_file)
        except:
            cached_results = {}

    vt_results = {}
    vt_urls = []

    # Apply limit
    subs_to_scan = subdomains
    if vt_limit > 0 and len(subdomains) > vt_limit:
        log_message(f"[*] VT limit applied: scanning top {vt_limit} of {len(subdomains)} subdomains", log_file)
        subs_to_scan = subdomains[:vt_limit]

    log_message(f"[*] Starting VT API scan on {len(subs_to_scan)} subdomains (delay: {delay}s, keys: {len(VT_API_KEYS)})", log_file)

    key_index = 0
    request_count = 0
    requests_per_key = 4  # VT free tier: ~4 req/min per key

    for i, sub in enumerate(subs_to_scan):
        # Check cache first
        if sub in cached_results:
            vt_results[sub] = cached_results[sub]
            log_message(f"    [CACHE] {sub} — skipped", log_file)
            continue

        api_key = VT_API_KEYS[key_index]
        url = f"https://www.virustotal.com/api/v3/domains/{sub}"
        headers = {"x-apikey": api_key}

        try:
            resp = requests.get(url, headers=headers, timeout=30)

            if resp.status_code == 200:
                data = resp.json()
                attrs = data.get('data', {}).get('attributes', {})
                stats = attrs.get('last_analysis_stats', {})

                result = {
                    'malicious': stats.get('malicious', 0),
                    'suspicious': stats.get('suspicious', 0),
                    'undetected': stats.get('undetected', 0),
                    'harmless': stats.get('harmless', 0),
                    'reputation': attrs.get('reputation', 0),
                    'categories': attrs.get('categories', {}),
                }
                vt_results[sub] = result

                total = result['malicious'] + result['suspicious'] + result['undetected'] + result['harmless']
                log_message(f"    [VT] {sub} — M:{result['malicious']} S:{result['suspicious']} U:{result['undetected']} (rep: {result['reputation']})", log_file)

            elif resp.status_code == 404:
                # Domain not in VT database
                vt_results[sub] = {
                    'malicious': 0, 'suspicious': 0, 'undetected': 0,
                    'harmless': 0, 'reputation': 0, 'categories': {},
                    'not_found': True
                }
                log_message(f"    [VT] {sub} — not found in VT database", log_file)

            elif resp.status_code == 429:
                log_message(f"    [VT] {sub} — rate limited, switching key...", log_file)
                key_index = (key_index + 1) % len(VT_API_KEYS)
                time.sleep(2)
                continue  # Retry this subdomain

            else:
                log_message(f"    [VT] {sub} — HTTP {resp.status_code}", log_file)

        except Exception as e:
            log_message(f"    [VT] {sub} — error: {e}", log_file)

        # Key rotation logic
        request_count += 1
        if request_count >= requests_per_key:
            key_index = (key_index + 1) % len(VT_API_KEYS)
            request_count = 0
            log_message(f"[*] Switched to VT API key #{key_index + 1}", log_file)

        # Progress
        if (i + 1) % 10 == 0:
            log_message(f"[*] VT progress: {i+1}/{len(subs_to_scan)} subdomains scanned", log_file)

        # Delay between requests
        if i < len(subs_to_scan) - 1:
            time.sleep(delay)

    # Save cache
    with open(vt_cache_file, 'w') as f:
        json.dump(vt_results, f, indent=2)
    log_message(f"[+] VT cache saved: {vt_cache_file}", log_file)

    # Write clean vt.txt output
    with open(vt_output_file, 'w') as f:
        f.write("=" * 80 + "\n")
        f.write(f"HANFY RECON v7.0 — VIRUSTOTAL RESULTS for {domain}\n")
        f.write("=" * 80 + "\n\n")

        for sub, result in sorted(vt_results.items()):
            f.write(f"Fetching data for domain: {sub}\n")
            if result.get('not_found'):
                f.write(f"No undetected URLs found for domain: {sub}\n")
            else:
                total = result['malicious'] + result['suspicious'] + result['undetected'] + result['harmless']
                f.write(f"  Malicious: {result['malicious']} | Suspicious: {result['suspicious']}\n")
                f.write(f"  Undetected: {result['undetected']} | Harmless: {result['harmless']}\n")
                f.write(f"  Reputation: {result['reputation']}\n")
                if result.get('categories'):
                    f.write(f"  Categories: {', '.join(result['categories'].values())}\n")
            f.write("\n" * 3)

    # Extract "undetected" URLs (domains with clean reputation)
    for sub, result in vt_results.items():
        if not result.get('not_found') and result.get('undetected', 0) > 0:
            # Build potential URLs from undetected domains
            vt_urls.append(f"https://{sub}")
            vt_urls.append(f"http://{sub}")

    vt_urls = list(dict.fromkeys(vt_urls))  # dedup
    log_message(f"[+] VT scan complete: {len(vt_results)} domains scanned, {len(vt_urls)} undetected URLs", log_file)

    return vt_results, vt_urls


