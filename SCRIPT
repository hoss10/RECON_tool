def severity_label(score):
    if score >= 90: return "🔴 CRITICAL"
    elif score >= 75: return "🟠 HIGH"
    elif score >= 60: return "🟡 MEDIUM"
    elif score >= 50: return "🔵 LOW"
    else: return "⚪ INFO"

def log_message(msg, log_file=None):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    formatted = f"[{timestamp}] {msg}"
    print(formatted)
    if log_file:
        with open(log_file, 'a') as f:
            f.write(formatted + "\n")

def is_safe_param(match_str):
    """Check if a matched parameter is in the safe/analytics blacklist."""
    param_part = match_str.split('=')[0] if '=' in match_str else ''
    param_name = param_part.lstrip('?&').lower()
    return param_name in SAFE_PARAMS

def should_skip_url_for_secrets(url):
    """Skip URLs with non-meaningful extensions for secrets."""
    parsed = urllib.parse.urlparse(url)
    path = parsed.path.lower()
    for ext in SKIP_EXTENSIONS:
        if path.endswith(ext):
            return True
    return False

