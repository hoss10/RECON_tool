def scan_status_codes_with_httpx(urls, outdir, domain, threads=50, log_file=None):
    """
    Scan URLs with httpx and write ONE file grouped by status code.
    Format: https://sub.workleap.com/path [200]
    Returns: (status_results_dict, bypass_403_urls_list, subdomain_info_dict)
    """
    reports_dir = Path(outdir) / "reports"
    reports_dir.mkdir(parents=True, exist_ok=True)
    status_file = reports_dir / f"{domain}_status_codes.txt"

    log_message(f"[*] Running httpx status code scan on {len(urls)} URLs...", log_file)

    # Write all URLs to input file
    input_file = Path(outdir) / "subs" / "_status_input_urls.txt"
    with open(input_file, 'w') as f:
        for url in urls:
            f.write(url + '\n')

    # Run httpx with status codes
    output_file = Path(outdir) / "subs" / "_httpx_output.txt"
    stdout, stderr, rc = run_cmd(
        f"httpx -l {input_file} -t {threads} -sc -title -tech -o {output_file} -silent 2>/dev/null",
        timeout=600
    )

    # Parse httpx output with REGEX (fixed parser)
    status_results = {code: [] for code in INTERESTING_STATUS_CODES}
    status_results['other'] = []
    all_results = []
    bypass_403_urls = []
    subdomain_info = {}  # NEW: dict mapping subdomain -> {status, title, tech}

    if output_file.exists():
        with open(output_file) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                # FIX: Use regex to extract first 3-digit status code
                match = re.search(r' \[(\d{3})\]', line)
                if match:
                    url = line.split(' [')[0].strip()
                    try:
                        status = int(match.group(1))
                    except ValueError:
                        continue

                    all_results.append({'url': url, 'status': status, 'raw': line})

                    if status in status_results:
                        status_results[status].append(url)
                    else:
                        status_results['other'].append(url)

                    if status == 403:
                        bypass_403_urls.append(url)

                    # NEW: Build subdomain_info dict
                    parsed = urllib.parse.urlparse(url)
                    sub = parsed.netloc.lower()
                    if sub not in subdomain_info:
                        subdomain_info[sub] = {
                            'status': status,
                            'title': '',
                            'tech': '',
                            'url': url,
                        }
                    # Try to extract title and tech from raw line
                    # httpx format: https://sub.com [200] [Title] [tech1,tech2]
                    title_match = re.search(r'\[([^\]]+)\]', line)
                    if title_match:
                        parts = re.findall(r'\[([^\]]+)\]', line)
                        if len(parts) >= 2:
                            subdomain_info[sub]['title'] = parts[1] if not parts[1].isdigit() else ''
                        if len(parts) >= 3:
                            subdomain_info[sub]['tech'] = parts[2]

    # Write ONE file grouped by status code
    with open(status_file, 'w') as f:
        f.write("=" * 80 + "\n")
        f.write(f"HANFY RECON v7.0 — STATUS CODES for {domain}\n")
        f.write("=" * 80 + "\n\n")

        for code in INTERESTING_STATUS_CODES:
            urls_list = status_results[code]
            if urls_list:
                f.write(f"\n{'='*60}\n")
