def enum_subdomains(domain, outdir, deep=False, recursive=False, limit=0, threads=100, log_file=None):
    """Enumerate subdomains using subfinder, assetfinder, amass, crt.sh.
    Returns: (live_subs_list, all_subs_list, subdomain_info_dict)
    """
    subs_dir = Path(outdir) / "subs"
    subs_dir.mkdir(parents=True, exist_ok=True)

    all_file = subs_dir / f"{domain}_subs_all.txt"
    live_file = subs_dir / f"{domain}_subs_live.txt"
    probe_file = subs_dir / f"{domain}_probe_input.txt"

    all_subs = set()

    # 1. subfinder (fast, passive)
    if tool_exists("subfinder"):
        log_message("[*] Running subfinder...", log_file)
        cmd = f"subfinder -d {domain} -all"
        if recursive:
            cmd += " -recursive"
        cmd += f" -o /tmp/_hanfy_subfinder_{domain}.txt 2>/dev/null"
        run_cmd(cmd, timeout=300)
        tmp = Path(f"/tmp/_hanfy_subfinder_{domain}.txt")
        if tmp.exists():
            with open(tmp) as f:
                for line in f:
                    sub = line.strip().lower()
                    if sub and sub.endswith(domain):
                        all_subs.add(sub)
            log_message(f"[+] subfinder: {len(all_subs)} subs", log_file)
    else:
        log_message("[-] subfinder not found", log_file)

    # 2. assetfinder (additional passive)
    if tool_exists("assetfinder"):
        log_message("[*] Running assetfinder...", log_file)
        stdout, stderr, rc = run_cmd(f"assetfinder --subs-only {domain} 2>/dev/null", timeout=300)
        if stdout:
            for line in stdout.strip().split('\n'):
                sub = line.strip().lower()
                if sub and sub.endswith(domain):
                    all_subs.add(sub)
            log_message(f"[+] assetfinder: {len(all_subs)} total subs", log_file)
    else:
        log_message("[-] assetfinder not found", log_file)

    # 3. crt.sh (certificate transparency) with retry logic
    log_message("[*] Querying crt.sh...", log_file)
    crt_data = None
    for attempt in range(3):
        try:
            req = urllib.request.Request(
                f"https://crt.sh/?q=%.{domain}&output=json",
                headers={'User-Agent': USER_AGENT}
            )
            with urllib.request.urlopen(req, timeout=60) as resp:
                crt_data = json.loads(resp.read().decode())
            break
        except Exception as e:
            wait = 5 * (attempt + 1)
            log_message(f"[-] crt.sh attempt {attempt+1}/3 failed: {e} — retrying in {wait}s", log_file)
            time.sleep(wait)

    if crt_data:
        for entry in crt_data:
            name = entry.get('name_value', '').strip().lower()
            for sub in name.split('\n'):
                sub = sub.strip().lstrip(r'*\.').lstrip('*.')
                if sub and sub.endswith(domain) and '.' in sub:
                    all_subs.add(sub)
        log_message(f"[+] crt.sh: {len(all_subs)} total subs", log_file)
    else:
        log_message("[-] crt.sh: all attempts failed", log_file)

    # 4. amass deep (optional, slow)
    if deep and tool_exists("amass"):
        log_message("[*] Running amass deep passive (this may take a while)...", log_file)
        stdout, stderr, rc = run_cmd(f"amass enum -passive -d {domain} 2>/dev/null", timeout=600)
        if stdout:
            for line in stdout.strip().split('\n'):
                sub = line.strip().lower()
                if sub and sub.endswith(domain):
                    all_subs.add(sub)
            log_message(f"[+] amass deep: {len(all_subs)} total subs", log_file)

    # Save master subs list
    with open(all_file, 'w') as f:
        for sub in sorted(all_subs):
            f.write(sub + '\n')

    log_message(f"[+] Total unique subdomains: {len(all_subs)}", log_file)

    # 5. Optional dnsx pre-resolution (auto-use if available)
    resolved_subs = set()
    if tool_exists("dnsx"):
        log_message("[*] Running dnsx pre-resolution (optional, auto-detected)...", log_file)
        dnsx_input = f"/tmp/_hanfy_dnsx_{domain}.txt"
        dnsx_output = f"/tmp/_hanfy_dnsx_{domain}_out.txt"
        with open(dnsx_input, 'w') as f:
            for sub in sorted(all_subs):
                f.write(sub + '\n')
        stdout, stderr, rc = run_cmd(
            f"dnsx -l {dnsx_input} -silent -o {dnsx_output} 2>/dev/null",
            timeout=300
        )
        if Path(dnsx_output).exists():
            with open(dnsx_output) as f:
                for line in f:
                    sub = line.strip().lower()
                    if sub:
                        resolved_subs.add(sub)
            log_message(f"[+] dnsx resolved: {len(resolved_subs)} live DNS records", log_file)
        else:
            log_message("[-] dnsx returned no results, falling back to all subs", log_file)
            resolved_subs = all_subs
    else:
        log_message("[-] dnsx not found, feeding all subs directly to httpx", log_file)
        resolved_subs = all_subs

    # 6. Wildcard detection
    if len(resolved_subs) >= 5:
        log_message("[*] Checking for wildcard DNS...", log_file)
        ip_map = {}
        sample = sorted(resolved_subs)[:20]
        for sub in sample:
            stdout, _, _ = run_cmd(f"dig +short {sub} | tail -n1", timeout=10)
            ip = stdout.strip()
            if ip:
                ip_map[ip] = ip_map.get(ip, 0) + 1
        for ip, count in ip_map.items():
            if count >= 5:
                log_message(f"[!] WILDCARD DETECTED: {count}/20 sample subs resolve to {ip}", log_file)
                log_message(f"[!] *.domain.com wildcard is active — expect many false 'live' hosts", log_file)
                break

    # 7. httpx probe — find live subs
    live_subs = set()
    with open(probe_file, 'w') as f:
        for sub in sorted(resolved_subs):
            f.write(f"http://{sub}\nhttps://{sub}\n")

    if tool_exists("httpx"):
        log_message(f"[*] Probing subdomains with httpx ({threads} threads)...", log_file)
        stdout, stderr, rc = run_cmd(
            f"httpx -l {probe_file} -t {threads} -sc -title -tech -o {live_file} 2>/dev/null",
            timeout=600
        )

        if live_file.exists():
            with open(live_file) as f:
                for line in f:
                    url = line.strip().split()[0] if line.strip() else ''
                    if url:
                        parsed = urllib.parse.urlparse(url)
                        live_subs.add(parsed.netloc.lower())
            log_message(f"[+] Live subdomains: {len(live_subs)}", log_file)
    else:
        log_message("[-] httpx not found, returning all resolved subs unprobed", log_file)
        live_subs = resolved_subs

    # Apply limit
    if limit > 0 and len(live_subs) > limit:
        log_message(f"[*] Limiting to top {limit} live subdomains", log_file)
        live_subs = set(sorted(live_subs)[:limit])

    return sorted(live_subs), sorted(all_subs)


