def bypass_403(urls, outdir, domain, threads=50, log_file=None):
    """Try 403 bypass on high-value endpoints using nomore403."""
    bypass_dir = Path(outdir) / "bypassed"
    bypass_dir.mkdir(parents=True, exist_ok=True)
    report_file = Path(outdir) / "reports" / f"{domain}_403_bypass.txt"
    report_file.parent.mkdir(parents=True, exist_ok=True)

    if not tool_exists("nomore403"):
        log_message("[-] nomore403 not found (install: go install github.com/devploit/nomore403@latest)", log_file)
        return []

    # Filter to high-value paths
    target_urls = []
    for url in urls:
        parsed = urllib.parse.urlparse(url)
        path = parsed.path.lower()
        if any(hv in path for hv in HIGH_VALUE_403_PATHS):
            target_urls.append(url)

    log_message(f"[*] Attempting 403 bypass on {len(target_urls)} high-value URLs...", log_file)

    # Write targets to file for nomore403
    targets_file = bypass_dir / f"{domain}_403_targets.txt"
    with open(targets_file, 'w') as f:
        for url in target_urls:
            f.write(url + '\n')

    # Run nomore403
    output_file = bypass_dir / f"{domain}_nomore403_output.txt"
    stdout, stderr, rc = run_cmd(
        f"nomore403 -u {targets_file} --random-agent -d 50 -l -o {output_file} 2>/dev/null",
        timeout=600
    )

    # Parse nomore403 output
    bypassed = []
    if output_file.exists():
        with open(output_file) as f:
            for line in f:
                if any(indicator in line for indicator in ['200', 'bypass', 'success']):
                    url_match = re.search(r'(https?://[^\s]+)', line)
                    if url_match:
                        bypassed.append({
                            'original': url_match.group(1),
                            'result': line.strip(),
                        })

    with open(report_file, 'w') as f:
        f.write("=" * 80 + "\n")
        f.write(f"HANFY RECON v7.0 — 403 BYPASS RESULTS for {domain}\n")
        f.write("=" * 80 + "\n\n")
        f.write(f"Total targets: {len(target_urls)}\n")
        f.write(f"Successful bypasses: {len(bypassed)}\n\n")

        if bypassed:
            for i, entry in enumerate(bypassed, 1):
                f.write(f"BYPASS #{i}:\n")
                f.write(f"  URL: {entry['original']}\n")
                f.write(f"  Result: {entry['result']}\n\n")
        else:
            f.write("No successful bypasses.\n")

    log_message(f"[+] 403 bypass: {report_file} ({len(bypassed)} successes)", log_file)
    return bypassed


